    {
      "name": "6. Cross-Hospital Access Grants",
      "item": [
        {
          "name": "Doctor Request Record Access Grant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.grant && res.grant.id) {",
                  "    pm.collectionVariables.set('testGrantId', res.grant.id);",
                  "    console.log('testGrantId automatically saved:', res.grant.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{testPatientId}}\",\n  \"targetHospitalId\": \"{{testTargetHospitalId}}\",\n  \"purpose\": \"Evaluation of past cardiology encounters and medication history\",\n  \"durationDays\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/grants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grants"]
            }
          }
        },
        {
          "name": "List Access Grants (Auto-scoped by Role)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.grants && res.grants.length > 0) {",
                  "    pm.collectionVariables.set('testGrantId', res.grants[0].id);",
                  "    console.log('testGrantId updated from list:', res.grants[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/grants?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grants"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
