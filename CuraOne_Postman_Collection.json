              "host": ["{{baseUrl}}"],
              "path": ["api", "grants", "{{testGrantId}}"]
            }
          }
        },
        {
          "name": "Patient Approve Access Grant (Consent)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"durationDays\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/grants/{{testGrantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grants", "{{testGrantId}}"]
            }
          }
        },
        {
          "name": "Patient Reject Access Grant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/grants/{{testGrantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grants", "{{testGrantId}}"]
            }
