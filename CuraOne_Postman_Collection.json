    {
      "name": "5. Patient Directory & Longitudinal Records",
      "item": [
        {
          "name": "Search Patients Directory (Doctor / Hospital)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.patients && res.patients.length > 0) {",
                  "    pm.collectionVariables.set('testPatientId', res.patients[0].id);",
                  "    console.log('testPatientId automatically saved:', res.patients[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients?search=raye",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients"],
              "query": [
                {
                  "key": "search",
                  "value": "raye"
                }
              ]
            }
          }
        },
